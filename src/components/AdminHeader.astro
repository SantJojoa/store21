---
interface Props {
    active?: "products" | "new";
}

const { active } = Astro.props;
---

<header class="border-b border-white/10 bg-white/5">
    <div
        class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between"
    >
        <div class="flex items-center gap-8">
            <span class="font-['Anton'] uppercase tracking-wide text-white"
                >Store 21 <span class="text-red-500">Admin</span></span
            >
            <nav class="flex items-center gap-5 text-sm">
                <a
                    href="/admin/products"
                    class={`uppercase tracking-wide transition-colors ${active === "products" ? "text-red-500" : "text-white/60 hover:text-white"}`}
                >
                    Productos
                </a>
                <a
                    href="/admin/products/new"
                    class={`uppercase tracking-wide transition-colors ${active === "new" ? "text-red-500" : "text-white/60 hover:text-white"}`}
                >
                    Nuevo producto
                </a>
            </nav>
        </div>
        <button
            id="admin-logout"
            class="text-sm text-white/60 hover:text-white transition-colors"
        >
            Cerrar sesión
        </button>
    </div>
</header>

<script>
    import { supabase } from "../lib/supabaseClient";

    document
        .getElementById("admin-logout")
        ?.addEventListener("click", async () => {
            await supabase.auth.signOut();
            window.location.href = "/admin/login";
        });
</script>
