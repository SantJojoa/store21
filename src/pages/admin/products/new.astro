---
import AdminHeader from "../../../components/AdminHeader.astro";
import { supabase } from "../../../lib/supabase";
import "../../../styles/global.css";

const { data: allCategories } = await supabase
    .from("categories")
    .select("id, name, slug, parent_id")
    .order("name");

const parents = (allCategories ?? []).filter((c) => !c.parent_id);
const childrenByParent = new Map<
    string,
    NonNullable<typeof allCategories>
>();
for (const c of allCategories ?? []) {
    if (c.parent_id) {
        if (!childrenByParent.has(c.parent_id))
            childrenByParent.set(c.parent_id, []);
        childrenByParent.get(c.parent_id)!.push(c);
    }
}
---

<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Nuevo producto | Admin Store 21</title>
    </head>

    <body class="min-h-screen bg-black">
        <AdminHeader active="new" />

        <main class="max-w-2xl mx-auto px-6 py-10">
            <h1 class="text-2xl font-['Anton'] uppercase text-white mb-6">
                Nuevo producto
            </h1>

            <form id="product-form" class="space-y-5">
                <div>
                    <label
                        for="name"
                        class="block text-xs uppercase tracking-wide text-white/50 mb-1"
                        >Nombre</label
                    >
                    <input
                        id="name"
                        required
                        class="w-full bg-white/10 border border-white/20 rounded px-3 py-2 text-sm text-white placeholder-white/40 focus:outline-none focus:border-red-500"
                    />
                </div>

                <div>
                    <label
                        for="description"
                        class="block text-xs uppercase tracking-wide text-white/50 mb-1"
                        >Descripción</label
                    >
                    <textarea
                        id="description"
                        rows="4"
                        class="w-full bg-white/10 border border-white/20 rounded px-3 py-2 text-sm text-white placeholder-white/40 focus:outline-none focus:border-red-500"
                    ></textarea>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label
                            for="price"
                            class="block text-xs uppercase tracking-wide text-white/50 mb-1"
                            >Precio (COP)</label
                        >
                        <input
                            id="price"
                            type="number"
                            min="0"
                            required
                            class="w-full bg-white/10 border border-white/20 rounded px-3 py-2 text-sm text-white placeholder-white/40 focus:outline-none focus:border-red-500"
                        />
                    </div>
                    <div>
                        <label
                            for="discount"
                            class="block text-xs uppercase tracking-wide text-white/50 mb-1"
                            >Descuento % (opcional)</label
                        >
                        <input
                            id="discount"
                            type="number"
                            min="0"
                            max="100"
                            class="w-full bg-white/10 border border-white/20 rounded px-3 py-2 text-sm text-white placeholder-white/40 focus:outline-none focus:border-red-500"
                        />
                    </div>
                </div>

                <div>
                    <label
                        for="category"
                        class="block text-xs uppercase tracking-wide text-white/50 mb-1"
                        >Categoría</label
                    >
                    <select
                        id="category"
                        required
                        class="w-full bg-white/10 border border-white/20 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-red-500"
                    >
                        <option
                            value=""
                            disabled
                            selected
                            class="bg-black text-white"
                        >
                            Selecciona una categoría
                        </option>
                        {
                            parents.map((parent) => {
                                const children =
                                    childrenByParent.get(parent.id) ?? [];
                                return children.length > 0 ? (
                                    <optgroup
                                        label={parent.name}
                                        class="bg-black text-white"
                                    >
                                        {children.map((child) => (
                                            <option
                                                value={child.id}
                                                data-slug={child.slug}
                                                class="bg-black text-white"
                                            >
                                                {child.name}
                                            </option>
                                        ))}
                                    </optgroup>
                                ) : (
                                    <option
                                        value={parent.id}
                                        data-slug={parent.slug}
                                        class="bg-black text-white"
                                    >
                                        {parent.name}
                                    </option>
                                );
                            })
                        }
                    </select>
                </div>

                <div>
                    <label
                        for="sizes"
                        class="block text-xs uppercase tracking-wide text-white/50 mb-1"
                        >Tallas (separadas por coma)</label
                    >
                    <input
                        id="sizes"
                        placeholder="S, M, L, XL"
                        class="w-full bg-white/10 border border-white/20 rounded px-3 py-2 text-sm text-white placeholder-white/40 focus:outline-none focus:border-red-500"
                    />
                </div>

                <div>
                    <label
                        for="images"
                        class="block text-xs uppercase tracking-wide text-white/50 mb-1"
                        >Imágenes</label
                    >
                    <input
                        id="images"
                        type="file"
                        accept="image/*"
                        multiple
                        required
                        class="w-full text-sm text-white/70 file:mr-4 file:rounded-full file:border-0 file:bg-red-600 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-red-500"
                    />
                </div>

                <p
                    id="form-status"
                    class="text-sm text-white/60 opacity-0 transition-opacity duration-300"
                >
                </p>

                <button
                    id="submit-btn"
                    type="submit"
                    class="w-full bg-red-600 text-white font-semibold py-3 rounded-full hover:bg-red-500 transition-colors active:scale-[0.98] disabled:opacity-50"
                >
                    Crear producto
                </button>
            </form>
        </main>

        <script>
            import { supabase } from "../../../lib/supabaseClient";

            const {
                data: { session },
            } = await supabase.auth.getSession();

            if (!session) {
                window.location.href = "/admin/login";
                throw new Error("No session");
            }

            const form = document.getElementById(
                "product-form",
            ) as HTMLFormElement;
            const statusEl = document.getElementById("form-status")!;
            const submitBtn = document.getElementById(
                "submit-btn",
            ) as HTMLButtonElement;

            function showStatus(message: string) {
                statusEl.textContent = message;
                statusEl.classList.remove("opacity-0");
            }

            form.addEventListener("submit", async (event) => {
                event.preventDefault();
                submitBtn.disabled = true;

                const name = (
                    document.getElementById("name") as HTMLInputElement
                ).value.trim();
                const description = (
                    document.getElementById(
                        "description",
                    ) as HTMLTextAreaElement
                ).value.trim();
                const price = Number(
                    (document.getElementById("price") as HTMLInputElement)
                        .value,
                );
                const discountRaw = (
                    document.getElementById("discount") as HTMLInputElement
                ).value.trim();
                const discount_percentage = discountRaw
                    ? Number(discountRaw)
                    : null;
                const categorySelect = document.getElementById(
                    "category",
                ) as HTMLSelectElement;
                const category_id = categorySelect.value;
                const categorySlug =
                    categorySelect.selectedOptions[0]?.dataset.slug ??
                    "productos";
                const sizes = (
                    document.getElementById("sizes") as HTMLInputElement
                ).value
                    .split(",")
                    .map((s) => s.trim())
                    .filter(Boolean);
                const files = Array.from(
                    (document.getElementById("images") as HTMLInputElement)
                        .files ?? [],
                );

                if (files.length === 0) {
                    showStatus("Selecciona al menos una imagen.");
                    submitBtn.disabled = false;
                    return;
                }

                const imageUrls: string[] = [];

                for (let i = 0; i < files.length; i++) {
                    const file = files[i];
                    showStatus(
                        `Subiendo imagen ${i + 1}/${files.length}...`,
                    );

                    const path = `${categorySlug}/${crypto.randomUUID()}-${file.name}`;
                    const { error: uploadError } = await supabase.storage
                        .from("product-images")
                        .upload(path, file);

                    if (uploadError) {
                        showStatus(
                            `Error subiendo imagen: ${uploadError.message}`,
                        );
                        submitBtn.disabled = false;
                        return;
                    }

                    const {
                        data: { publicUrl },
                    } = supabase.storage
                        .from("product-images")
                        .getPublicUrl(path);
                    imageUrls.push(publicUrl);
                }

                showStatus("Guardando producto...");

                const { error: insertError } = await supabase
                    .from("products")
                    .insert({
                        name,
                        description,
                        price,
                        discount_percentage,
                        category_id,
                        sizes,
                        image_urls: imageUrls,
                    });

                if (insertError) {
                    showStatus(
                        `Error guardando producto: ${insertError.message}`,
                    );
                    submitBtn.disabled = false;
                    return;
                }

                window.location.href = "/admin/products";
            });
        </script>
    </body>
</html>
